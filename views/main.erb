<!DOCTYPE html>
<html ng-app="listeApp">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Liste de courses</title>
    <link rel="stylesheet" href="/css/angular-material.min.css">
    <link href="css/icon_family=Material+Icons.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <script src="js/angular.min.js"></script>
    <script src="js/angular-sanitize.js"></script>
    <script src="js/angular-animate.min.js"></script>
    <script src="js/angular-aria.min.js"></script>
    <script src="js/angular-messages.min.js"></script>
    <script src="js/angular-material.min.js"></script>
    <script src="js/liste.helpers.js"></script>
    <script src="js/liste.js"></script>
</head>
<body ng-controller="ListeCtrl">

<md-toolbar class="md-tall">
    <span ><!-- Juste pour faire du vide --></span>
    <h1><span style="margin-left:2%">El toolos de la faisaciòn dela listà dell courses</span></h1>
</md-toolbar>

<% unless @errors.empty? %>
    <md-toolbar class="md-accent">
        <h2 class="md-toolbar-tools">
            <% @errors.each do |m| %><span><%= Rack::Utils.escape_html(m) %></span><% end %>
        </h2>
    </md-toolbar>
<% end %>

<div layout="row">
    <md-card flex="100">
        <md-card-header style="width: 95%" layout="column">
            <div layout="row" layout-sm="column" layout-align="start" style="width: 100%">
                <div layout="row">
                    <% if @errors.empty? %>
                    <md-button class="md-primary md-raised" ng-click="toggleListe()" >
                            Toggle Liste
                    </md-button>
                    <md-button class="md-primary md-raised" ng-click="showPromptSave($event)" >
                            Save Liste
                    </md-button>
                    <md-button class="md-primary md-raised" ng-click="showPromptLoad($event)" >
                            Load Liste
                    </md-button>
                    <md-button class="md-accent md-raised" ng-click="startShoppingCurrent()" ng-disabled="!liste_rayons || !liste_rayons.length">
                            Faire les courses
                    </md-button>
                    <md-button href="/recettes-editor">
                            Recettes
                    </md-button>
                    <% end %>
                </div>
            </div>
        </md-card-header>
        <md-card-content>
            <h2 class="liste-title">Liste</h2>
            <div class="liste-rayons">
                <div ng-repeat="rayon in liste_rayons" class="rayon-section">
                    <h3 class="rayon-header">{{rayon.name}}</h3>
                    <ul class="rayon-items">
                        <li ng-repeat="item in rayon.items" class="liste-item">
                            <span class="item-name">{{item.name}}</span>
                            <span class="item-qty" ng-if="displayQty(item) || item.editing">
                                <button class="qty-btn" ng-click="adjustQty(item, -1)" ng-if="!item.editing">−</button>
                                <span class="qty-value" ng-if="!item.editing" ng-click="startEditQty(item)" title="Cliquer pour modifier">{{displayQty(item)}}</span>
                                <span class="qty-edit" ng-if="item.editing">
                                    <input class="qty-edit-input" type="number" min="0" step="any" ng-model="item.editVal"
                                        ng-blur="commitEditQty(item)"
                                        ng-keydown="$event.key==='Enter' && commitEditQty(item) || $event.key==='Escape' && cancelEditQty(item)"
                                        focus-on="item.editing">
                                    <span class="qty-edit-unit">{{item.unit}}</span>
                                </span>
                                <button class="qty-btn" ng-click="adjustQty(item, 1)" ng-if="!item.editing">+</button>
                            </span>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="add-item-row">
                <md-input-container class="add-item-article">
                    <label>Article</label>
                    <input ng-model="new_item.name" ng-keydown="$event.key==='Enter' && addCustomItem()">
                </md-input-container>
                <md-input-container class="add-item-qty">
                    <label>Qté</label>
                    <input ng-model="new_item.qty" type="number" min="0" step="any">
                </md-input-container>
                <md-input-container class="add-item-unit">
                    <label>Unité</label>
                    <input ng-model="new_item.unit">
                </md-input-container>
                <md-input-container class="add-item-rayon">
                    <md-select ng-model="new_item.rayon" placeholder="Rayon">
                        <md-option ng-repeat="r in enum_rayon" ng-value="$index">{{r}}</md-option>
                    </md-select>
                </md-input-container>
                <md-button class="md-primary md-raised" ng-click="addCustomItem()" ng-disabled="!new_item.name.trim()">+</md-button>
            </div>
            <div ng-repeat="item in custom_items" layout="row" layout-align="start center" class="custom-item-row">
                <span flex class="custom-item-label">{{item.name}}<span ng-if="item.qty" class="custom-item-qty"> — {{item.qty}}{{item.unit ? ' ' + item.unit : ''}}</span></span>
                <md-button class="md-icon-button" ng-click="removeCustomItem($index)" aria-label="Supprimer">✕</md-button>
            </div>
            <md-input-container class="md-block">
                <label>Texte libre</label>
                <textarea ng-model="extras_txt" md-select-on-focus></textarea>
            </md-input-container>
        </md-card-content>
    </md-card>

    <div id="columnMid" flex="100">
        <md-card>
            <md-card-title><span class="md-headline">Valeurs globales</span></md-card-title>
            <md-card-content>
                <md-input-container class="md-block">
                    <label >Nombre de jours</label>
                    <input type="number" max="20" ng-model="nb_jours" ng-change="joursChanged()">
                </md-input-container>
                <md-input-container class="md-block">
                    <label>Recette des matins</label>
                    <md-select ng-model="recette_matin" ng-change="updateListe()" placeholder="Recette matin">
                        <md-option ng-value="{{null}}">---</md-option>
                        <md-option ng-repeat="recette in recettes_matin" ng-value="recette.name">{{recette.name}}</md-option>
                    </md-select>
                </md-input-container>
            </md-card-content>
        </md-card>
        <md-list style="padding:0px">
            <div ng-repeat="jour in range_jours track by $index" md-ink-ripple="false" md-ni-ink="true">
                <md-card class="jour-card">
                    <md-card-content class="jour-card-content">
                        <span class="jour-label">Jour {{$index+1}}</span>
                        <div class="meal-row">
                            <span class="meal-label">Matin</span>
                            <input type="number" max="100" class="gens-input" ng-model="gens_par_matin[$index]" ng-change="updateListe()">
                            <span class="pers-label">pers.</span>
                        </div>
                        <div class="meal-row">
                            <span class="meal-label">Midi</span>
                            <md-select class="meal-select" ng-model="recette_dejeuner_par_jour[$index]" ng-change="updateListe()" placeholder="---">
                                <md-option ng-value="{{null}}">---</md-option>
                                <md-option ng-repeat="recette in recettes" ng-value="recette.name">{{recette.name}}</md-option>
                            </md-select>
                            <input type="number" max="100" class="gens-input" ng-model="gens_par_dejeuner[$index]" ng-change="updateListe()">
                            <span class="pers-label">pers.</span>
                        </div>
                        <div class="meal-row">
                            <span class="meal-label">Soir</span>
                            <md-select class="meal-select" ng-model="recette_diner_par_jour[$index]" ng-change="updateListe()" placeholder="---">
                                <md-option ng-value="{{null}}">---</md-option>
                                <md-option ng-repeat="recette in recettes" ng-value="recette.name">{{recette.name}}</md-option>
                            </md-select>
                            <input type="number" max="100" class="gens-input" ng-model="gens_par_diner[$index]" ng-change="updateListe()">
                            <span class="pers-label">pers.</span>
                        </div>
                    </md-card-content>
                </md-card>
            </div>
        </md-list>
    </div>
    <md-card layout-align="start start" id="columnRight" flex="100">
    <md-card-header layout-align=""><span class="md-headline">Extras</span></md-card-header>
    <md-card-content>
        <md-list layout="column">
            <md-checkbox ng-repeat="e in extras" ng-model="e.enabled" ng-change="updateListe()">{{e.name}}</md-checkbox>
        </md-list>
    </md-card-content>
    </md-card>
</div>

</body>
</html>
