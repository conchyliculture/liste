<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Éditeur de recettes</title>
    <link rel="icon" type="image/svg+xml" href="/img/logo.svg">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/recettes_editor.css">
    <script defer src="/js/alpine.min.js"></script>
    <script src="/js/recettes_editor.js"></script>
</head>
<body x-data="editorApp()" x-cloak>

<header class="topbar">
    <div class="topbar-inner">
        <h1 class="brand">
            <img class="brand-logo" src="/img/logo.svg" alt="">
            <span class="brand-text">Éditeur de recettes</span>
        </h1>
        <nav class="topbar-actions">
            <a class="btn btn-ghost" href="/">
                <span class="ico">←</span><span class="label">Retour</span>
            </a>
        </nav>
    </div>
</header>

<div class="editor-tabs">
    <div class="tabs">
        <button class="tab" :class="{active: tabIndex === 0}" @click="switchTab(0)">Recettes</button>
        <button class="tab" :class="{active: tabIndex === 1}" @click="switchTab(1)">Recettes du matin</button>
        <button class="tab" :class="{active: tabIndex === 2}" @click="switchTab(2)">Ingrédients</button>
    </div>
</div>

<div class="editor-container">
    <!-- Left: recipe list (tabs 0 & 1) -->
    <aside class="editor-list-panel" x-show="tabIndex < 2">
        <button class="btn btn-primary editor-new-btn" @click="newRecette()">
            <span class="ico">＋</span><span class="label">Nouvelle recette</span>
        </button>
        <ul class="editor-list">
            <template x-for="r in currentList" :key="r.name">
                <li class="editor-list-item"
                    @click="selectRecette(r)"
                    :class="{active: selected && selected._originalName === r.name}">
                    <span class="eli-name" x-text="r.name"></span>
                </li>
            </template>
        </ul>
    </aside>

    <!-- Left: ingredient catalog list (tab 2) -->
    <aside class="editor-list-panel" x-show="tabIndex === 2">
        <button class="btn btn-primary editor-new-btn" @click="newIng()">
            <span class="ico">＋</span><span class="label">Nouvel ingrédient</span>
        </button>
        <div class="editor-search">
            <input type="search" class="input" x-model="ingSearch" placeholder="Rechercher…">
        </div>
        <ul class="editor-list">
            <template x-for="ing in filteredCatalog" :key="ing.name">
                <li class="editor-list-item"
                    @click="selectIng(ing)"
                    :class="{active: selectedIng && selectedIng._originalName === ing.name}">
                    <span class="eli-name" x-text="ing.name"></span>
                    <span class="eli-meta" x-text="ing.rayon"></span>
                </li>
            </template>
        </ul>
    </aside>

    <!-- Right: placeholder (recipes) -->
    <section class="editor-panel" x-show="tabIndex < 2 && !selected">
        <div class="editor-empty">
            <div class="editor-empty-icon">🍽️</div>
            <p>Sélectionnez une recette ou créez-en une nouvelle.</p>
        </div>
    </section>

    <!-- Right: placeholder (ingredients) -->
    <section class="editor-panel" x-show="tabIndex === 2 && !selectedIng">
        <div class="editor-empty">
            <div class="editor-empty-icon">🛒</div>
            <p>Sélectionnez un ingrédient ou créez-en un nouveau.</p>
        </div>
    </section>

    <!-- Right: ingredient editor -->
    <section class="editor-panel" x-show="tabIndex === 2 && selectedIng">
        <div class="card editor-card" x-show="selectedIng">
            <label class="field">
                <span class="field-label">Nom de l'ingrédient</span>
                <input class="input" required
                       :value="selectedIng ? selectedIng.name : ''"
                       @input="if (selectedIng) selectedIng.name = $event.target.value">
            </label>

            <div class="field-row">
                <label class="field" style="flex:1">
                    <span class="field-label">Rayon</span>
                    <select class="input"
                            @change="if (selectedIng) selectedIng.rayon = $event.target.value">
                        <template x-for="r in rayons" :key="r">
                            <option :value="r" :selected="selectedIng && selectedIng.rayon === r" x-text="r"></option>
                        </template>
                    </select>
                </label>
                <button class="btn btn-ghost ico-btn" @click="addRayon()" title="Ajouter un rayon">＋</button>
            </div>

            <label class="field">
                <span class="field-label">Unité par défaut (optionnel)</span>
                <input class="input" placeholder="ex: g, cL, tranche(s)…"
                       :value="selectedIng ? selectedIng.unit : ''"
                       @input="if (selectedIng) selectedIng.unit = $event.target.value">
            </label>

            <div class="editor-actions">
                <button class="btn btn-warn" @click="deleteIng()"
                        x-show="selectedIng && !selectedIng._isNew">
                    <span class="ico">🗑️</span><span class="label">Supprimer</span>
                </button>
                <span class="grow"></span>
                <button class="btn btn-ghost" @click="cancelIngEdit()">Annuler</button>
                <button class="btn btn-primary" @click="saveIng()">
                    <span class="ico">💾</span><span class="label">Enregistrer</span>
                </button>
            </div>
        </div>
    </section>

    <!-- Right: recipe editor -->
    <section class="editor-panel" x-show="tabIndex < 2 && selected">
        <div class="card editor-card" x-show="selected">
            <label class="field">
                <span class="field-label">Nom de la recette</span>
                <input class="input" required
                       :value="selected ? selected.name : ''"
                       @input="if (selected) selected.name = $event.target.value">
            </label>

            <div class="ing-header">
                <span class="card-title">Ingrédients</span>
                <button class="btn btn-ghost" @click="addIngredient()">
                    <span class="ico">＋</span><span class="label">Ajouter</span>
                </button>
            </div>

            <datalist id="ing-list">
                <template x-for="n in ingredientNames" :key="n">
                    <option :value="n"></option>
                </template>
            </datalist>

            <table class="ing-table">
                <thead>
                    <tr>
                        <th class="ing-name-cell">Ingrédient</th>
                        <th class="ing-qty-cell">Qté</th>
                        <th class="ing-del-cell"></th>
                    </tr>
                </thead>
                <tbody>
                    <template x-for="(ing, idx) in (selected ? selected.ingredients : [])" :key="idx">
                        <tr class="ing-row">
                            <td class="ing-name-cell">
                                <input type="text" class="input" x-model="ing.name"
                                       list="ing-list" placeholder="Ingrédient">
                            </td>
                            <td class="ing-qty-cell">
                                <input type="number" class="input qty-input" x-model="ing.qty"
                                       min="0" step="any" placeholder="—">
                            </td>
                            <td class="ing-del-cell">
                                <button class="x" @click="removeIngredient(idx)"
                                        aria-label="Supprimer l'ingrédient">✕</button>
                            </td>
                        </tr>
                    </template>
                </tbody>
            </table>

            <label class="field">
                <span class="field-label">Instructions (Markdown supporté)</span>
                <textarea class="input textarea instructions-textarea" rows="10"
                          :value="selected ? selected.instructions : ''"
                          @input="if (selected) selected.instructions = $event.target.value"
                          placeholder="Listes (- item), **gras**, # titres, etc."></textarea>
            </label>

            <div class="editor-actions">
                <button class="btn btn-warn" @click="deleteRecette()"
                        x-show="selected && !selected._isNew">
                    <span class="ico">🗑️</span><span class="label">Supprimer</span>
                </button>
                <span class="grow"></span>
                <button class="btn btn-ghost" @click="cancelEdit()">Annuler</button>
                <button class="btn btn-primary" @click="save()">
                    <span class="ico">💾</span><span class="label">Enregistrer</span>
                </button>
            </div>
        </div>
    </section>
</div>

<!-- ── Confirm modal ───────────────────────────────────────────────────── -->
<div class="modal" x-show="confirmDialog" @click.self="confirmCancel()"
     @keydown.escape.window="confirmCancel()" x-cloak x-transition.opacity>
    <div class="modal-card">
        <h2 x-text="confirmDialog && confirmDialog.title"></h2>
        <p class="muted" x-show="confirmDialog && confirmDialog.body"
           x-text="confirmDialog && confirmDialog.body"></p>
        <div class="modal-actions">
            <button class="btn btn-ghost" @click="confirmCancel()"
                    x-text="confirmDialog && confirmDialog.cancelLabel"></button>
            <button class="btn btn-primary" @click="confirmOk()"
                    x-text="confirmDialog && confirmDialog.okLabel"></button>
        </div>
    </div>
</div>

<!-- ── Prompt modal ────────────────────────────────────────────────────── -->
<div class="modal" x-show="promptDialog" @click.self="promptCancel()"
     @keydown.escape.window="promptCancel()" x-cloak x-transition.opacity>
    <div class="modal-card">
        <h2 x-text="promptDialog && promptDialog.title"></h2>
        <input class="input"
               :value="promptDialog ? promptDialog.value : ''"
               @input="if (promptDialog) promptDialog.value = $event.target.value"
               :placeholder="promptDialog ? promptDialog.placeholder : ''"
               @keydown.enter.prevent="promptOk()"
               x-effect="if (promptDialog) $nextTick(() => $el.focus())">
        <div class="modal-actions">
            <button class="btn btn-ghost" @click="promptCancel()"
                    x-text="promptDialog && promptDialog.cancelLabel"></button>
            <button class="btn btn-primary" @click="promptOk()"
                    x-text="promptDialog && promptDialog.okLabel"></button>
        </div>
    </div>
</div>

<div class="toast" x-show="toast" x-text="toast" x-transition.opacity></div>

</body>
</html>
